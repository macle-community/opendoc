@import '../common/index.mass';.maui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.maui-multi-ellipsis--l2{-webkit-line-clamp:2}.maui-multi-ellipsis--l2,.maui-multi-ellipsis--l3{-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.maui-multi-ellipsis--l3{-webkit-line-clamp:3}.maui-clearfix:after{clear:both;content:"";display:table}.maui-hairline,.maui-hairline--bottom,.maui-hairline--left,.maui-hairline--right,.maui-hairline--surround,.maui-hairline--top,.maui-hairline--top-bottom{position:relative}.maui-hairline--bottom:after,.maui-hairline--left:after,.maui-hairline--right:after,.maui-hairline--surround:after,.maui-hairline--top-bottom:after,.maui-hairline--top:after,.maui-hairline:after{border:0 solid #ebedf0;bottom:-50%;box-sizing:border-box;content:" ";left:-50%;pointer-events:none;position:absolute;right:-50%;top:-50%;-webkit-transform:scale(.5);transform:scale(.5);-webkit-transform-origin:center;transform-origin:center}.maui-hairline--top:after{border-top-width:1px}.maui-hairline--left:after{border-left-width:1px}.maui-hairline--right:after{border-right-width:1px}.maui-hairline--bottom:after{border-bottom-width:1px}.maui-hairline--top-bottom:after{border-width:1px 0}.maui-hairline--surround:after{border-width:1px}.maui-slider{background-color:var(--slider-inactive-background-color,#ebedf0);border-radius:999px;height:var(--slider-bar-height,2px);position:relative}.maui-slider:before{bottom:calc(var(--padding-xs, 8px)*-1);content:"";left:0;position:absolute;right:0;top:calc(var(--padding-xs, 8px)*-1)}.maui-slider__bar{background-color:var(--slider-active-background-color,#1989fa);border-radius:inherit;height:100%;position:relative;transition:all .2s;width:100%}.maui-slider__button{background-color:var(--slider-button-background-color,#fff);border-radius:var(--slider-button-border-radius,50%);box-shadow:var(--slider-button-box-shadow,0 1px 2px rgba(0,0,0,.5));height:var(--slider-button-height,24px);width:var(--slider-button-width,24px)}.maui-slider__button-wrapper,.maui-slider__button-wrapper-right{position:absolute;right:0;top:50%;-webkit-transform:translate3d(50%,-50%,0);transform:translate3d(50%,-50%,0)}.maui-slider__button-wrapper-left{left:0;position:absolute;top:50%;-webkit-transform:translate3d(-50%,-50%,0);transform:translate3d(-50%,-50%,0)}.maui-slider--vertical{display:inline-block;height:100%;width:var(--slider-bar-height,2px)}.maui-slider--vertical .maui-slider__button-wrapper,.maui-slider--vertical .maui-slider__button-wrapper-left{left:auto;right:50%;top:0;-webkit-transform:translate3d(50%,-50%,0);transform:translate3d(50%,-50%,0)}.maui-slider--vertical .maui-slider__button-wrapper-right{bottom:0;right:50%;top:auto;-webkit-transform:translate3d(50%,50%,0);transform:translate3d(50%,50%,0)}.maui-slider--vertical:before{bottom:0;left:-8px;right:-8px;top:0}.maui-slider--disabled{opacity:var(--slider-disabled-opacity,.5)}