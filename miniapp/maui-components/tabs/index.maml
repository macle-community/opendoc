<sjs src="../sjs/utils.sjs" module="utils" />
<sjs src="./index.sjs" module="computed" />

<view class="custom-class {{ utils.mbem('tabs') }}" id="{{ _id }}" style="{{ customStyle }}">
    <maui-sticky disabled="{{ !sticky }}" z-index="{{ zIndex }}" offset-top="{{ offsetTop }}" container="{{ container }}" bind:scroll="onTouchScroll">
        <view class="{{ utils.mbem('tabs--') + type }} {{ utils.mbem('tabs__wrap', { scrollable }) }} {{ type === 'line' && border ? 'maui-hairline--top-bottom' : '' }} wrap-class" style="{{ wrapStyle }}">
            <scroll-view scroll-x="{{ scrollable }}" scroll-with-animation="{{ scrollWithAnimation }}" scroll-left="{{ scrollLeft }}" class="{{ utils.mbem('tabs__scroll', [type]) }}" style="{{ color ? 'border-color: ' + color : '' }}">
                <view data-id="{{ _id }}" class="{{ utils.mbem('tabs__nav', [type, { complete: !ellipsis }]) }} nav-class" style="{{ computed.navStyle(color, type) }}; {{ navStyle }}">
                    <view ma:if="{{ type === 'line' }}" data-id="{{ _id }}" class="maui-tabs__line" style="{{ computed.lineStyle({ color, lineOffsetLeft, lineHeight, skipTransition, duration, lineWidth, inited }) }}" />
                    <view ma:for="{{ tabs }}" ma:key="{{ computed.key(index, _id) }}" data-id="{{ _id }}" data-index="{{ index }}" class="{{ computed.tabClass(index === currentIndex, ellipsis) }} {{ utils.mbem('tab', { active: index === currentIndex, disabled: item.disabled, complete: !ellipsis }) }}" style="{{ computed.tabStyle({ active: index === currentIndex, ellipsis, color, type, disabled: item.disabled, titleActiveColor, titleInactiveColor, swipeThreshold, scrollable }) }}" bind:tap="onTap">
                        <view class="{{ ellipsis ? 'maui-ellipsis' : '' }}" style="{{ item.titleStyle }}; white-space : nowrap; {{ computed.customTabStyle({active: index === currentIndex, tabActiveStyle: tabActiveStyle, tabStyle: tabStyle}) }}">
                            {{ item.title }}
                            <block ma:if="{{ computed.showInfo(item) }}">
                                <maui-info info="{{ item.info }}" dot="{{ item.dot }}" custom-class="maui-tab__title__info" custom-style="position: relative !important;top: -1px !important; transform: translateX(0) !important;" />
                            </block>
                        </view>
                    </view>
                </view>
            </scroll-view>
        </view>
    </maui-sticky>

    <view class="maui-tabs__content" bind:touchstart="onTouchStart" bind:touchmove="onTouchMove" bind:touchend="onTouchEnd" bind:touchcancel="onTouchEnd">
        <view class="{{ utils.mbem('tabs__track', [{ animated }]) }} maui-tabs__track" style="{{ computed.trackStyle({ duration, currentIndex, animated }) }}">
            <slot />
        </view>
    </view>
</view>

