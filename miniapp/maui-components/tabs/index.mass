user-select:none;user-select:none}.maui-tabs__nav--card{box-sizing:border-box;height:30px}.maui-tabs__nav--card .maui-tab{border-right:1px solid #ee0a24;color:#ee0a24;line-height:28px}.maui-tabs__nav--card .maui-tab:last-child{border-right:none}.maui-tabs__nav--card .maui-tab.maui-tab--active{background-color:#ee0a24;color:#fff}.maui-tabs__nav--card .maui-tab--disabled{color:#c8c9cc}.maui-tabs__line{background-color:#ee0a24;border-radius:3px;bottom:0;height:3px;left:0;opacity:0;position:absolute;z-index:1}.maui-tabs__track{height:100%;position:relative;width:100%}.maui-tabs__track--animated{display:flex;transition-property:left}.maui-tabs__content{overflow:hidden}.maui-tabs--line{height:44px}.maui-tabs--card{height:30px}.maui-tab{box-sizing:border-box;color:#646566;cursor:pointer;flex:1;font-size:14px;line-height:44px;min-width:0;padding:0 5px;position:relative;text-align:center}.maui-tab--active{color:#323233;font-weight:500}.maui-tab--disabled{color:#c8c9cc}.maui-tab__title__info{position:relative!important;top:-1px!important;-webkit-transform:translateX(0)!important;transform:translateX(0)!important}