<sjs src="./index.sjs" module="computed" />
<sjs src="../sjs/utils.sjs" module="utils" />

<view class="{{utils.bem('image',{round})}}" style="{{computed.rootStyle({width,height,radius})}}" bindtap="onClick">
    <image ma:if="{{ !error }}" src="{{src}}" mode="{{mode}}" class='maui-image__image' bindload="onLoad" binderror="onError" />
    <view ma:if="{{loading && showLoading}}" class="maui-image__loading">
        <image class="maui-image__loading" src="data:image/png;base64," />
    </view>
    <image ma:if="{{error && showError}}" class='maui-image__image' src="data:image/png;base64," />
</view>

