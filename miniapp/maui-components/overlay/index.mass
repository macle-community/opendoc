@import '../common/index.mass';.overlay{align-items:center;background-color:rgba(0,0,0,.6);display:flex;height:100vh;justify-content:center;left:0;opacity:0;pointer-events:none;position:fixed;top:0;transition:opacity var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1),visibility var(--overlay-duration,.3s) step-end;visibility:hidden;width:100vw}.overlay--show{opacity:1;pointer-events:auto;transition:opacity var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1),visibility 0s linear;visibility:visible}.overlay--content{opacity:0;-webkit-transform:scale(.8);transform:scale(.8);-webkit-transform-origin:center;transform-origin:center;transition:opacity var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1),-webkit-transform var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1);transition:opacity var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1),transform var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1);transition:opacity var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1),transform var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1),-webkit-transform var(--overlay-duration,.3s) cubic-bezier(.34,1.56,.64,1);will-change:opacity,transform}.overlay--show .overlay--content{opacity:1;-webkit-transform:scale(1);transform:scale(1)}