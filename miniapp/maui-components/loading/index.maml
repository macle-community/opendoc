<sjs src="../sjs/utils.sjs" module="utils" />
<sjs src="./loading.sjs" module="computed" />

<view class="custom-class {{ utils.bem('loading', { vertical }) }}" style="{{ customStyle }}">
  <view
    class="maui-loading__spinner maui-loading__spinner--{{ type }}"
    style="{{ computed.spinnerStyle({ color, size }) }}"
  >
    <view
      ma:if="{{ type === 'spinner' }}"
      ma:for="{{ styleArray }}"
      class="maui-loading__dot"
    />
  </view>
  <view class="maui-loading__text" style="{{ computed.textStyle({ textSize }) }}">
    <slot />
  </view>
</view>
