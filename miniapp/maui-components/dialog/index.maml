<sjs src="../sjs/utils.sjs" module="utils"/>
<view>
    <maui-popup show="{{ show }}" z-index="{{ zIndex }}" overlay="{{ overlay }}" custom-style="width: {{ utils.addUnit(width || 320) }};border-radius:16px;{{ customStyle }}" overlay-style="{{ overlayStyle }}" close-on-click-overlay="{{ closeOnClickOverlay }}" bind:close="clickOverlay">
        <view ma:if="{{ title }}" class="{{ utils.bem('dialog__header', { isolated: !(message || useSlot) }) }}" style={{titleStyle}}>
            {{ title }}
        </view>
        <slot ma:if="{{ useSlot }}" />
        <view ma:elif="{{ message }}" class="{{ utils.bem('dialog__message', [theme, messageAlign, { hasTitle: title }]) }}" style={{messageStyle}}>
            <text class="maui-dialog__message-text">{{ message }}</text>
        </view>
        <view ma:if="{{ showCancelButton || showConfirmButton }}" class="maui-hairline--top maui-dialog__footer maui-dialog__container">
            <block ma:if="{{ showCancelButton }}">
                <button class="maui-dialog__button maui-hairline--right maui-button maui-button--default" loading="{{ loading.cancel }}" style="color: {{ cancelButtonColor }};border-bottom-left-radius: 16px;border-bottom-right-radius: {{ showConfirmButton ? 0 : '16px' }};" bind:tap="cancel">
                    {{ cancelButtonText }}
                </button>
            </block>

            <block ma:if="{{ showConfirmButton }}">
                <button class="maui-dialog__button maui-button maui-button--default" loading="{{ loading.confirm }}" style="color: {{ confirmButtonColor }};border-bottom-left-radius: {{ showCancelButton ? 0 : '16px' }};border-bottom-right-radius: 16px;" bind:tap="confirm">
                    {{ confirmButtonText }}
                </button>
            </block>
        </view>
    </maui-popup>
</view>

