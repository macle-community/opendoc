@import '../common/index.mass';.maui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.maui-multi-ellipsis--l2{-webkit-line-clamp:2}.maui-multi-ellipsis--l2,.maui-multi-ellipsis--l3{-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.maui-multi-ellipsis--l3{-webkit-line-clamp:3}.maui-clearfix:after{clear:both;content:"";display:table}.maui-hairline,.maui-hairline--bottom,.maui-hairline--left,.maui-hairline--right,.maui-hairline--surround,.maui-hairline--top,.maui-hairline--top-bottom{position:relative}.maui-hairline--bottom:after,.maui-hairline--left:after,.maui-hairline--right:after,.maui-hairline--surround:after,.maui-hairline--top-bottom:after,.maui-hairline--top:after,.maui-hairline:after{border:0 solid #ebedf0;bottom:-50%;box-sizing:border-box;content:" ";left:-50%;pointer-events:none;position:absolute;right:-50%;top:-50%;-webkit-transform:scale(.5);transform:scale(.5);-webkit-transform-origin:center;transform-origin:center}.maui-hairline--top:after{border-top-width:1px}.maui-hairline--left:after{border-left-width:1px}.maui-hairline--right:after{border-right-width:1px}.maui-hairline--bottom:after{border-bottom-width:1px}.maui-hairline--top-bottom:after{border-width:1px 0}.maui-hairline--surround:after{border-width:1px}.maui-title-bar{background-color:var(--title-bar-background-color,#fff);box-sizing:initial;height:var(--title-bar-height,44px);line-height:var(--title-bar-height,44px);position:relative;text-align:center;-webkit-user-select:none;user-select:none}.maui-title-bar__content{height:100%;position:relative}.maui-title-bar__text{color:var(--title-bar-text-color,#1989fa);display:inline-block;margin:0 calc(var(--padding-md, 16px)*-1);padding:0 var(--padding-md,16px);vertical-align:middle}.maui-title-bar__text--hover{background-color:#f2f3f5}.maui-title-bar__arrow{color:var(--title-bar-icon-color,#1989fa)!important;font-size:var(--title-bar-arrow-size,16px)!important;vertical-align:middle}.maui-title-bar__arrow+.maui-title-bar__text{margin-left:-20px;padding-left:25px}.maui-title-bar--fixed{left:0;position:fixed!important;top:0;width:100%}.maui-title-bar__title{color:var(--title-bar-title-text-color,#323233);font-size:var(--title-bar-title-font-size,16px);font-weight:var(--font-weight-bold,500);margin:0 auto;max-width:50%}.maui-title-bar__left,.maui-title-bar__right{align-items:center;bottom:0;display:flex;font-size:var(--font-size-md,14px);position:absolute;top:0}.maui-title-bar__right{right:var(--padding-md,16px)}.maui-title-bar__left{left:var(--padding-md,16px)}