<sjs src="../sjs/utils.sjs" module="utils" />
<sjs src="./index.sjs" module="computed" />

<view class="{{ utils.bem('radio', [direction, { 'label-left': labelPosition === 'left' }]) }}">
    <view class="maui-radio__icon-wrap" style="font-size: {{ utils.addUnit(iconSize) }}" bindtap="onChange">
        <maui-icon ma:if="{{ value != null && name != null && value === name }}" name="{{ customIcon }}" class="{{ utils.bem('radio__icon', [shape, { disabled: disabled || parentDisabled, checked: (value != null && name != null && value === name) }]) }}" style="{{ computed.iconStyle({ iconSize, checkedColor, disabled, parentDisabled, value, name }) }}" custom-style="{{ computed.iconCustomStyle({ iconSize }) }}" />
        <view ma:else class="{{ utils.bem('radio__icon', [shape, { disabled: disabled || parentDisabled, checked: (value != null && name != null && value === name) }]) }}" style="{{ computed.iconStyle({ iconSize, checkedColor, disabled, parentDisabled, value, name }) }}" custom-style="{{ computed.iconCustomStyle({ iconSize }) }}" />
    </view>
    <view class="{{ utils.bem('radio__label', [labelPosition, { disabled: disabled || parentDisabled }]) }}" bindtap="onClickLabel">
        <slot />
    </view>
</view>
