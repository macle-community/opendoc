@import '../common/index.mass';.maui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.maui-multi-ellipsis--l2{-webkit-line-clamp:2}.maui-multi-ellipsis--l2,.maui-multi-ellipsis--l3{-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.maui-multi-ellipsis--l3{-webkit-line-clamp:3}.maui-clearfix:after{clear:both;content:"";display:table}.maui-hairline,.maui-hairline--bottom,.maui-hairline--left,.maui-hairline--right,.maui-hairline--surround,.maui-hairline--top,.maui-hairline--top-bottom{position:relative}.maui-hairline--bottom:after,.maui-hairline--left:after,.maui-hairline--right:after,.maui-hairline--surround:after,.maui-hairline--top-bottom:after,.maui-hairline--top:after,.maui-hairline:after{border:0 solid #ebedf0;bottom:-50%;box-sizing:border-box;content:" ";left:-50%;pointer-events:none;position:absolute;right:-50%;top:-50%;-webkit-transform:scale(.5);transform:scale(.5);-webkit-transform-origin:center;transform-origin:center}.maui-hairline--top:after{border-top-width:1px}.maui-hairline--left:after{border-left-width:1px}.maui-hairline--right:after{border-right-width:1px}.maui-hairline--bottom:after{border-bottom-width:1px}.maui-hairline--top-bottom:after{border-width:1px 0}.maui-hairline--surround:after{border-width:1px}.maui-list-item{align-items:center;background-color:var(--list-background-color,#fff);color:var(--list-content-color,#333);line-height:1.4}.maui-list-item-hover{background-color:var(--list-item-border-color,#e5e5e5)}.maui-list-item-line{align-items:center;display:flex;flex:1;padding:0 24rpx;position:relative}.maui-list-item-line-disabled{opacity:.4}.maui-list-item-line-divider:after{background-color:#e5e5e5;bottom:0;content:"";display:block;height:1px;left:0;position:absolute;right:0;top:auto;-webkit-transform:scaleY(.5);transform:scaleY(.5)}.maui-list-item-image{border-radius:50vh}.maui-list-item-image-large-icon{font-size:80rpx}.maui-list-item-image-large-image{height:80rpx;width:80rpx}.maui-list-item-image-normal-icon{font-size:56rpx}.maui-list-item-image-normal-image{height:56rpx;width:56rpx}.maui-list-item-image-container{margin-right:24rpx}.maui-list-item-image-container:empty{display:none}.maui-list-item-content-container{display:flex;flex:1;flex-direction:column;padding:24rpx 0}.maui-list-item-content-container-small-text{font-size:24rpx;line-height:33rpx}.maui-list-item-content-container-normal-text{font-size:28rpx;line-height:40rpx}.maui-list-item-content-main{font-size:32rpx;line-height:45rpx}.maui-list-item-content-brief-container,.maui-list-item-content-title-container{color:var(--list-extra-brief-color,#999)}.maui-list-item-extra{display:flex;flex-direction:row-reverse;font-size:32rpx;line-height:45rpx}.maui-list-item-extra:empty{display:none}.maui-list-item-extra-container{display:flex;flex-direction:column}.maui-list-item-extra-brief{color:var(--list-extra-brief-color,#999);display:flex;flex-direction:row-reverse;font-size:28rpx;line-height:40rpx}.maui-list-item-arrow{align-items:center;color:var(--list-item-text-color,#ccc);display:flex;margin-left:8rpx}.maui-list-item-arrow .maui-icon{font-size:36rpx}.maui-list-item-arrow-large-margin{margin-left:24rpx}.maui-list-item .line{background-color:var(--list-item-border-color,#e5e5e5);height:1rpx;position:absolute;right:0;width:calc(100% - 1rpx*24)}