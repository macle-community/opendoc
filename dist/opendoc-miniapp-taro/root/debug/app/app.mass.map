page {
  height: 100%;
}

page {
  background-color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1e293b;
  box-sizing: border-box;
}

.page-body {
  padding: 12rpx;
}

.demo-block {
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f1f5f9;
}

.demo-title {
  font-size: 14rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
  display: block;
  border-left: 3rpx solid #2563eb;
  padding-left: 8rpx;
}

.demo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.demo-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

