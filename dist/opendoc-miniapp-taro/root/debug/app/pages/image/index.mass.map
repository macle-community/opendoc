/* pages/image/index.css */
.img-grid { display: flex; gap: 12rpx; }
.img-card { flex: 1; background: #fff; padding: 8rpx; border-radius: 8rpx; border: 1rpx solid #e2e8f0; text-align: center; }
.demo-img { width: 100%; height: 110rpx; border-radius: 6rpx; background: #f8fafc; }
.img-label { font-size: 11rpx; color: #64748b; margin-top: 6rpx; display: block; }

.wide-img { width: 100%; border-radius: 8rpx; }


