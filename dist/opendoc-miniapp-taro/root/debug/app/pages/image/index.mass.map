/* pages/image/index.css */
.img-grid { display: flex; gap: 24rpx; }
.img-card { flex: 1; background: #fff; padding: 16rpx; border-radius: 16rpx; border: 2rpx solid #e2e8f0; text-align: center; }
.demo-img { width: 100%; height: 220rpx; border-radius: 12rpx; background: #f8fafc; }
.img-label { font-size: 22rpx; color: #64748b; margin-top: 12rpx; display: block; }

.wide-img { width: 100%; border-radius: 16rpx; }


