/* pages/view/index.css */
.flex-row { display: flex; flex-direction: row; gap: 10rpx; }
.flex-col { display: flex; flex-direction: column; gap: 10rpx; }
.flex-item { height: 50rpx; flex: 1; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: bold; border-radius: 6rpx; }
.demo-bg-red { background-color: #ef4444; }
.demo-bg-green { background-color: #10b981; }
.demo-bg-blue { background-color: #3b82f6; }

.stream { display: flex; flex-direction: column; gap: 12rpx; }
.post { display: flex; background: #fff; padding: 12rpx; border-radius: 8rpx; border: 1rpx solid #e2e8f0; }
.post-hover { background-color: #f1f5f9; }
.post-user { display: flex; flex-direction: column; align-items: center; width: 60rpx; margin-right: 12rpx; }
.post-avatar { width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #0284c7; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; }
.post-name { font-size: 12rpx; color: #64748b; margin-top: 4rpx; }
.post-body { flex: 1; }
.post-content { font-size: 14rpx; color: #1e293b; line-height: 1.5; }
.post-date { font-size: 11rpx; color: #94a3b8; margin-top: 6rpx; }


