/* pages/view/index.css */
.flex-row { display: flex; flex-direction: row; gap: 20rpx; }
.flex-col { display: flex; flex-direction: column; gap: 20rpx; }
.flex-item { height: 100rpx; flex: 1; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: bold; border-radius: 12rpx; }
.demo-bg-red { background-color: #ef4444; }
.demo-bg-green { background-color: #10b981; }
.demo-bg-blue { background-color: #3b82f6; }

.stream { display: flex; flex-direction: column; gap: 24rpx; }
.post { display: flex; background: #fff; padding: 24rpx; border-radius: 16rpx; border: 2rpx solid #e2e8f0; }
.post-hover { background-color: #f1f5f9; }
.post-user { display: flex; flex-direction: column; align-items: center; width: 120rpx; margin-right: 24rpx; }
.post-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #0284c7; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; }
.post-name { font-size: 24rpx; color: #64748b; margin-top: 8rpx; }
.post-body { flex: 1; }
.post-content { font-size: 28rpx; color: #1e293b; line-height: 1.5; }
.post-date { font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; }


