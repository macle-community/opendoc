
.home-container { padding: 12rpx; }
.home-banner {
  background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
  color: #ffffff;
  padding: 22rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}
.banner-title { font-size: 20rpx; font-weight: 800; display: block; margin-bottom: 6rpx; }
.banner-sub { font-size: 12rpx; opacity: 0.9; display: block; line-height: 1.4; }
.nav-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.nav-item {
  background: #f1f5f9;
  border-radius: 8rpx;
  padding: 11rpx 12rpx;
  font-size: 13rpx;
  font-weight: 600;
  color: #334155;
  width: calc(50% - 4rpx);
  box-sizing: border-box;
  text-align: center;
}
.full-width { width: 100% !important; }

