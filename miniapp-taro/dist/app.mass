page {
  background-color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1e293b;
  box-sizing: border-box;
}

.taro-badge-banner {
  background: #0f172a;
  color: #38bdf8;
  padding: 8rpx 14rpx;
  font-size: 11rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border-bottom: 1rpx solid #1e293b;
}

.demo-block {
  margin: 14rpx 12rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.demo-title {
  font-size: 14rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
  display: block;
}

.demo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.demo-col {
  margin-bottom: 12rpx;
}

.demo-layout-col {
  background-color: #38bdf8;
  color: #ffffff;
  text-align: center;
  border-radius: 4rpx;
  padding: 10rpx 0;
  font-size: 12rpx;
  font-weight: 600;
  box-sizing: border-box;
  border: 1rpx dashed rgba(255, 255, 255, 0.7);
}

.demo-layout-col-alt {
  background-color: #0284c7;
  color: #ffffff;
  text-align: center;
  border-radius: 4rpx;
  padding: 10rpx 0;
  font-size: 12rpx;
  font-weight: 600;
  box-sizing: border-box;
  border: 1rpx dashed rgba(255, 255, 255, 0.7);
}

