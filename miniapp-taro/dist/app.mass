page {
  height: 100%;
}
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #323233;
  box-sizing: border-box;
}

.demo-block {
  margin: 16rpx 12rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.demo-title {
  font-size: 14rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
  display: block;
}

.demo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.demo-col {
  margin-bottom: 12rpx;
}

/* Layout Grid Column Visual Borders */
.maui-row {
  margin-bottom: 12rpx;
}
.maui-col {
  border: 1.5rpx solid #0284c7;
  background-color: #f0f9ff;
  color: #0369a1;
  text-align: center;
  border-radius: 4rpx;
  line-height: 38rpx;
  margin-bottom: 6rpx;
  font-weight: 600;
  font-size: 13rpx;
}
.maui-col:nth-child(even) {
  background-color: #e0f2fe;
}

