/* pages/radio-group/index.css */
.radio-list { display: flex; flex-direction: column; gap: 20rpx; }
.radio-item { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; background: #fff; padding: 20rpx; border-radius: 12rpx; }
.selected-plan { margin-top: 20rpx; font-size: 26rpx; color: #2563eb; font-weight: 600; }


