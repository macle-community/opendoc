
.home-container { padding: 24rpx; }
.home-banner {
  background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
  color: #ffffff;
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
}
.banner-title { font-size: 40rpx; font-weight: 800; display: block; margin-bottom: 12rpx; }
.banner-sub { font-size: 24rpx; opacity: 0.9; display: block; line-height: 1.4; }
.nav-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.nav-item {
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  text-align: center;
}
.full-width { width: 100% !important; }

