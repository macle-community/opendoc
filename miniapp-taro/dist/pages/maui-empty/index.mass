
.page-body {
  padding: 16rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}
.demo-block {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.05);
}
.demo-title {
  font-size: 14rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
  display: block;
}
.btn-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.item-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.icon-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}
.col-box {
  color: #fff;
  font-size: 12rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 4rpx;
}
.bg-dark { background-color: #39a9ed; }
.bg-light { background-color: #66c6f2; }
.overlay-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #fff;
  font-weight: bold;
}
.tab-content {
  padding: 20rpx;
  text-align: center;
  color: #64748b;
  font-size: 14rpx;
}

