.page-body { padding: 8rpx 0; }
.maui-col {
  border: 1.5rpx solid #0284c7;
  background-color: #f0f9ff;
  color: #0369a1;
  text-align: center;
  border-radius: 4rpx;
  line-height: 38rpx;
  margin-bottom: 6rpx;
  font-weight: 600;
  font-size: 13rpx;
}
.maui-col:nth-child(even) {
  background-color: #e0f2fe;
}

