/* pages/swiper-item/index.css */
.swiper-custom-item { padding: 10rpx; box-sizing: border-box; }
.card-content { background: #f8fafc; border: 2rpx dashed #94a3b8; height: 100%; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.card-title { font-weight: bold; color: #1e293b; font-size: 15rpx; }
.card-sub { font-size: 12rpx; color: #64748b; margin-top: 4rpx; }


