/* pages/swiper-item/index.css */
.swiper-custom-item { padding: 20rpx; box-sizing: border-box; }
.card-content { background: #f8fafc; border: 4rpx dashed #94a3b8; height: 100%; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.card-title { font-weight: bold; color: #1e293b; font-size: 30rpx; }
.card-sub { font-size: 24rpx; color: #64748b; margin-top: 8rpx; }


