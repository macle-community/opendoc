/* pages/scroll-view/index.css */
.scroll-v-item { height: 70rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; margin-bottom: 8rpx; border-radius: 8rpx; }
.bg-red { background: #ef4444; } .bg-orange { background: #f97316; } .bg-green { background: #10b981; } .bg-blue { background: #3b82f6; }

.scroll-h-item { display: inline-block; width: 110rpx; height: 80rpx; margin-right: 10rpx; border-radius: 8rpx; text-align: center; line-height: 80rpx; color: #fff; font-weight: 600; }
.bg-purple { background: #8b5cf6; } .bg-pink { background: #ec4899; }


