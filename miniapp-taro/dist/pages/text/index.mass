/* pages/text/index.css */
.text-group { display: flex; flex-direction: column; gap: 16rpx; }
.text-headline { font-size: 34rpx; font-weight: 700; color: #0f172a; }
.text-sub { font-size: 26rpx; color: #64748b; }
.text-selectable { font-size: 26rpx; color: #2563eb; background: #eff6ff; padding: 12rpx 20rpx; border-radius: 12rpx; border: 2rpx dashed #bfdbfe; }

.text-group text { font-size: 28rpx; color: #334155; }


