/* pages/navigator/index.css */
.nav-container { display: flex; flex-direction: column; gap: 20rpx; }
.nav-btn { background: #fff; border: 2rpx solid #cbd5e1; padding: 24rpx 28rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 500; color: #2563eb; }
.nav-hover { background: #f1f5f9; }

