/* pages/navigator/index.css */
.nav-container { display: flex; flex-direction: column; gap: 10rpx; }
.nav-btn { background: #fff; border: 1rpx solid #cbd5e1; padding: 12rpx 14rpx; border-radius: 8rpx; font-size: 14rpx; font-weight: 500; color: #2563eb; }
.nav-hover { background: #f1f5f9; }

