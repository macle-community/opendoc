@import '../common/index.mass';.maui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.maui-multi-ellipsis--l2{-webkit-line-clamp:2}.maui-multi-ellipsis--l2,.maui-multi-ellipsis--l3{-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.maui-multi-ellipsis--l3{-webkit-line-clamp:3}.maui-clearfix:after{clear:both;content:"";display:table}.maui-hairline,.maui-hairline--bottom,.maui-hairline--left,.maui-hairline--right,.maui-hairline--surround,.maui-hairline--top,.maui-hairline--top-bottom{position:relative}.maui-hairline--bottom:after,.maui-hairline--left:after,.maui-hairline--right:after,.maui-hairline--surround:after,.maui-hairline--top-bottom:after,.maui-hairline--top:after,.maui-hairline:after{border:0 solid #ebedf0;bottom:-50%;box-sizing:border-box;content:" ";left:-50%;pointer-events:none;position:absolute;right:-50%;top:-50%;-webkit-transform:scale(.5);transform:scale(.5);-webkit-transform-origin:center;transform-origin:center}.maui-hairline--top:after{border-top-width:1px}.maui-hairline--left:after{border-left-width:1px}.maui-hairline--right:after{border-right-width:1px}.maui-hairline--bottom:after{border-bottom-width:1px}.maui-hairline--top-bottom:after{border-width:1px 0}.maui-hairline--surround:after{border-width:1px}.maui-radio{align-items:center;display:flex;overflow:hidden;-webkit-user-select:none;user-select:none}.maui-radio__icon-wrap{flex:none}.maui-radio--horizontal{margin-right:var(--padding-sm,12px)}.maui-radio__icon{align-items:center;border:1px solid var(--radio-border-color,#c8c9cc);box-sizing:border-box;display:flex;font-size:var(--radio-size,20px);height:1em;justify-content:center;text-align:center;transition-duration:var(--radio-transition-duration,.2s);transition-property:color,border-color,background-color;width:1em}.maui-radio__icon--round{border-radius:100%}.maui-radio__icon--checked{background-color:var(--radio-checked-icon-color,#1989fa);border-color:var(--radio-checked-icon-color,#1989fa);color:#fff}.maui-radio__icon--disabled{background-color:var(--radio-disabled-background-color,#ebedf0);border-color:var(--radio-disabled-icon-color,#c8c9cc)}.maui-radio__icon--disabled.maui-radio__icon--checked{color:var(--radio-disabled-icon-color,#c8c9cc)}.maui-radio__label{word-wrap:break-word;color:var(--radio-label-color,#323233);line-height:var(--radio-size,20px);padding-left:var(--radio-label-margin,10px)}.maui-radio__label:empty{margin:0}.maui-radio__label--left{float:left;margin:0 var(--radio-label-margin,10px) 0 0}.maui-radio__label--disabled{color:var(--radio-disabled-label-color,#c8c9cc)}
.maui-radio--label-left {
  flex-direction: row-reverse;
  justify-content: flex-end;
}
.maui-radio--label-left .maui-radio__label {
  padding-left: 0;
  padding-right: var(--radio-label-margin, 10px);
}
