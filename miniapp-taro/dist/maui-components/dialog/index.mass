@import '../common/index.mass';.maui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.maui-multi-ellipsis--l2{-webkit-line-clamp:2}.maui-multi-ellipsis--l2,.maui-multi-ellipsis--l3{-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.maui-multi-ellipsis--l3{-webkit-line-clamp:3}.maui-clearfix:after{clear:both;content:"";display:table}.maui-hairline,.maui-hairline--bottom,.maui-hairline--left,.maui-hairline--right,.maui-hairline--surround,.maui-hairline--top,.maui-hairline--top-bottom{position:relative}.maui-hairline--bottom:after,.maui-hairline--left:after,.maui-hairline--right:after,.maui-hairline--surround:after,.maui-hairline--top-bottom:after,.maui-hairline--top:after,.maui-hairline:after{border:0 solid #ebedf0;bottom:-50%;box-sizing:border-box;content:" ";left:-50%;pointer-events:none;position:absolute;right:-50%;top:-50%;-webkit-transform:scale(.5);transform:scale(.5);-webkit-transform-origin:center;transform-origin:center}.maui-hairline--top:after{border-top-width:1px}.maui-hairline--left:after{border-left-width:1px}.maui-hairline--right:after{border-right-width:1px}.maui-hairline--bottom:after{border-bottom-width:1px}.maui-hairline--top-bottom:after{border-width:1px 0}.maui-hairline--surround:after{border-width:1px}.maui-dialog{background-color:var(--dialog-background-color,#fff);border-radius:var(--dialog-border-radius,16px);font-size:var(--dialog-font-size,16px);overflow:hidden;top:45%!important;width:var(--dialog-width,320px)}.maui-dialog__header{font-weight:var(--dialog-header-font-weight,500);line-height:var(--dialog-header-line-height,24px);padding-top:var(--dialog-header-padding-top,24px);text-align:center}.maui-dialog__header--isolated{padding:var(--dialog-header-isolated-padding,24px 0)}.maui-dialog__container{display:flex}.maui-dialog__message{-webkit-overflow-scrolling:touch;font-size:var(--dialog-message-font-size,14px);line-height:var(--dialog-message-line-height,20px);max-height:var(--dialog-message-max-height,60vh);overflow-y:auto;padding:var(--dialog-message-padding,24px);text-align:center}.maui-dialog__message-text{word-wrap:break-word}.maui-dialog__message--hasTitle{color:var(--dialog-has-title-message-text-color,#646566);padding-top:var(--dialog-has-title-message-padding-top,8px)}.maui-dialog__message--left{text-align:left}.maui-dialog__message--right{text-align:right}.maui-dialog__message--justify{text-align:justify}.maui-dialog__button{flex:1}.maui-dialog__cancel,.maui-dialog__confirm{border:0!important}.maui-button{-webkit-text-size-adjust:none;text-size-adjust:none;align-items:center;-webkit-appearance:none;appearance:none;border-radius:var(--button-border-radius,2px);box-sizing:border-box;display:inline-flex;font-size:var(--button-default-font-size,16px);height:var(--button-default-height,44px);justify-content:center;line-height:var(--button-line-height,20px);padding:0;position:relative;text-align:center;transition:opacity .2s;vertical-align:middle}.maui-button--default{background-color:var(--button-default-background-color,#fff);border-color:var(--button-default-border-color,#ebedf0);border-style:solid;border-width:var(--button-border-width,1px);color:var(--button-default-color,#323233)}