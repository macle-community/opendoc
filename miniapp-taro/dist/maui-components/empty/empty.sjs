/* eslint-disable */
var imageOpt = ['error', 'search', 'default', 'network'];
var imagePth = [
'data:image/svg+xml;base64,',
  'data:image/svg+xml;base64,',
  'data:image/svg+xml;base64,',
  'data:image/svg+xml;base64,'
  ]

function imageUrl (image) {
  var tagIndex = imageOpt.indexOf(image)
  if (tagIndex !== -1) {
    return imagePth[tagIndex];
  }

  return image;
}

module.exports = {
  imageUrl: imageUrl,
};

