/* eslint-disable */
var style = require('../sjs/style.sjs');
var addUnit = require('../sjs/add-unit.sjs');
var images = {
  'success-white':
    'data:image/svg+xml;base64,',
  'success-black':
    'data:image/svg+xml;base64,',
  add: 'data:image/svg+xml;charset=utf-8;base64,',
  arrow:
    'data:image/svg+xml;charset=utf-8;base64,',
  calendar:
    'data:image/svg+xml;charset=utf-8;base64,',
  'cell-phone':
    'data:image/svg+xml;charset=utf-8;base64,',
  checklist:
    'data:image/svg+xml;charset=utf-8;base64,',
  classification:
    'data:image/svg+xml;charset=utf-8;base64,',
  collect:
    'data:image/svg+xml;charset=utf-8;base64,',
  copy: 'data:image/svg+xml;charset=utf-8;base64,',
  correct:
    'data:image/svg+xml;charset=utf-8;base64,',
  cross:
    'data:image/svg+xml;charset=utf-8;base64,',
  keyDelete:
    'data:image/svg+xml;charset=utf-8;base64,',
  dialogue:
    'data:image/svg+xml;charset=utf-8;base64,',
  download:
    'data:image/svg+xml;charset=utf-8;base64,',
  label:
    'data:image/svg+xml;charset=utf-8;base64,',
  'place-markers':
    'data:image/svg+xml;charset=utf-8;base64,',
  prohibit:
    'data:image/svg+xml;charset=utf-8;base64,',
  recycle:
    'data:image/svg+xml;charset=utf-8;base64,',
  reduce:
    'data:image/svg+xml;charset=utf-8;base64,',
  remind:
    'data:image/svg+xml;charset=utf-8;base64,',
  setting:
    'data:image/svg+xml;charset=utf-8;base64,',
  shopping:
    'data:image/svg+xml;charset=utf-8;base64,',
  upload:
    'data:image/svg+xml;charset=utf-8;base64,',
  arrowleft:
    'data:image/png;base64,'
};

function isImage(name) {
  return name && name.indexOf('/') !== -1;
}

function rootClass(data) {
  var classes = [];

  if (data.classPrefix != null) {
    classes.push(data.classPrefix);
  }

  if (isImage(data.name)) {
    classes.push('maui-icon--image');
  } else if (data.classPrefix != null) {
    classes.push(data.classPrefix + '-' + data.name);
  }

  return classes.join(' ');
}

function calImageSrc(name) {
  if (name === 'delete') {
    return images['keyDelete'];
  }
  return images[name] || name;
}

function rootStyle(data) {
  return style([
    {
      height: addUnit(data.size),
      width: addUnit(data.size)
    },
    data.customStyle
  ]);
}

function changeColor(data) {
  return style([
    {
      'background-color': data.color,
      '-webkit-mask-box-image': 'url(' + calImageSrc(data.name) + ') 0 100% 0 0',
    }
  ]);
}

module.exports = {
  isImage: isImage,
  rootClass: rootClass,
  rootStyle: rootStyle,
  calImageSrc: calImageSrc,
  changeColor: changeColor
};
