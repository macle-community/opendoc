@import '../common/index.mass';.maui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.maui-multi-ellipsis--l2{-webkit-line-clamp:2}.maui-multi-ellipsis--l2,.maui-multi-ellipsis--l3{-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.maui-multi-ellipsis--l3{-webkit-line-clamp:3}.maui-clearfix:after{clear:both;content:"";display:table}.maui-hairline,.maui-hairline--bottom,.maui-hairline--left,.maui-hairline--right,.maui-hairline--surround,.maui-hairline--top,.maui-hairline--top-bottom{position:relative}.maui-hairline--bottom:after,.maui-hairline--left:after,.maui-hairline--right:after,.maui-hairline--surround:after,.maui-hairline--top-bottom:after,.maui-hairline--top:after,.maui-hairline:after{border:0 solid #ebedf0;bottom:-50%;box-sizing:border-box;content:" ";left:-50%;pointer-events:none;position:absolute;right:-50%;top:-50%;-webkit-transform:scale(.5);transform:scale(.5);-webkit-transform-origin:center;transform-origin:center}.maui-hairline--top:after{border-top-width:1px}.maui-hairline--left:after{border-left-width:1px}.maui-hairline--right:after{border-right-width:1px}.maui-hairline--bottom:after{border-bottom-width:1px}.maui-hairline--top-bottom:after{border-width:1px 0}.maui-hairline--surround:after{border-width:1px}.maui-modal-body{background-color:var(--modal-background-color,#fff);border-radius:16rpx;display:flex;flex-direction:column;padding-top:40rpx;width:560rpx}.maui-modal-body-title{color:var(--modal-title-color,#333);font-size:36rpx;line-height:50rpx;margin:0 24rpx 16rpx;text-align:center}.maui-modal-body-content{color:var(--modal-content-color,#333);font-size:30rpx;line-height:42rpx;margin:0 24rpx 40rpx;text-align:center}.maui-modal-body-footer-focus{padding:0 24rpx 24rpx}.maui-modal-body-footer-focus-primary{background-color:#1677ff;border-radius:50vh;color:#fff;text-align:center}.maui-modal-body-footer-focus-cancel,.maui-modal-body-footer-focus-secondary{color:#1677ff;font-size:36rpx;margin-top:16rpx;padding-top:24rpx;text-align:center}.maui-modal-body-footer-vertical{padding:0 0 24rpx}.maui-modal-body-footer-vertical-cancel,.maui-modal-body-footer-vertical-primary,.maui-modal-body-footer-vertical-secondary{color:#1677ff;font-size:36rpx;margin-top:16rpx;padding-top:24rpx;position:relative;text-align:center}.maui-modal-body-footer-vertical-cancel:before,.maui-modal-body-footer-vertical-primary:before,.maui-modal-body-footer-vertical-secondary:before{background-color:#e5e5e5;bottom:auto;content:"";display:block;height:1px;left:0;position:absolute;right:0;top:0;-webkit-transform:scaleY(.5);transform:scaleY(.5)}.maui-modal-body-footer-horizontal{display:flex;flex-direction:row;position:relative}.maui-modal-body-footer-horizontal:before{background-color:#e5e5e5;bottom:auto;content:"";display:block;height:1px;left:0;position:absolute;right:0;top:0;-webkit-transform:scaleY(.5);transform:scaleY(.5)}.maui-modal-body-footer-horizontal-cancel,.maui-modal-body-footer-horizontal-primary,.maui-modal-body-footer-horizontal-secondary{color:#1677ff;flex:1;font-size:36rpx;padding:24rpx 0;position:relative;text-align:center}.maui-modal-body-footer-horizontal-cancel:first-child:after,.maui-modal-body-footer-horizontal-primary:first-child:after,.maui-modal-body-footer-horizontal-secondary:first-child:after{background-color:#e5e5e5;bottom:0;content:"";display:block;left:auto;position:absolute;right:0;top:0;-webkit-transform:scaleX(.5);transform:scaleX(.5);width:1px}.maui-modal-close{align-items:center;color:var(--modal-close-text-color,#999);display:flex;font-size:36rpx;height:58rpx;justify-content:center;position:absolute;right:16rpx;top:13rpx;width:52rpx;z-index:3}