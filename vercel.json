{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/openplatform/macledocs/#/guide/installDevtool?locale=en_US",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/openplatform/macledocs/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/openplatform/macledocs/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap.json",
      "destination": "/sitemap.json"
    },
    {
      "source": "/api/simulator-info",
      "destination": "/api/simulator-info.json"
    },
    {
      "source": "/_simulator/:match*",
      "destination": "/_simulator/:match*"
    },
    {
      "source": "/openplatform/macledocs/_simulator/:match*",
      "destination": "/_simulator/:match*"
    },
    {
      "source": "/miniapp/:match*",
      "destination": "/miniapp/:match*"
    },
    {
      "source": "/opendoc-miniapp-taro/:match*",
      "destination": "/opendoc-miniapp-taro/:match*"
    },
    {
      "source": "/openplatform/macledocs/:match*",
      "destination": "/:match*"
    },
    {
      "source": "/openplatform/macledocs",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|sitemap.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}

